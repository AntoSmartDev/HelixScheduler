<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <PackageId>HelixScheduler.Infrastructure.SqlServer</PackageId>
    <Version>2.0.1</Version>
    <Authors>Antonio Angiò (AntoSmartDev)</Authors>
    <Description>SQL Server provider integration for HelixScheduler.Infrastructure, including provider wiring, migrations, and SQL Server-specific migration bootstrap.</Description>
    <PackageTags>scheduling;availability;sql-server;ef-core;migrations;provider</PackageTags>
    <PackageReleaseNotes>Patch release fixing SQL Server migration integrity on empty database bootstrap.</PackageReleaseNotes>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AntoSmartDev/HelixScheduler</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/AntoSmartDev/HelixScheduler</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HelixScheduler.Infrastructure\HelixScheduler.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

