<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>HelixScheduler.Application</PackageId>
    <Version>2.0.1</Version>
    <Authors>Antonio Angiò (AntoSmartDev)</Authors>
    <Description>Application-layer orchestration, management capabilities, and read-side services built on HelixScheduler.Core.</Description>
    <PackageTags>scheduling;availability;management;resource-catalog;property-schema;orchestration</PackageTags>
    <PackageReleaseNotes>Patch release fixing SQL Server bootstrap validation path for the packaged application stack.</PackageReleaseNotes>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AntoSmartDev/HelixScheduler</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/AntoSmartDev/HelixScheduler</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HelixScheduler.Core\HelixScheduler.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
