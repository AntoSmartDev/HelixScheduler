<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestoreSources>$(RestoreSources);https://api.nuget.org/v3/index.json;$(MSBuildThisFileDirectory)..\..\artifacts\packages</RestoreSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HelixScheduler.Core" Version="2.0.1" />
    <PackageReference Include="HelixScheduler.Application" Version="2.0.1" />
    <PackageReference Include="HelixScheduler.Infrastructure" Version="2.0.1" />
    <PackageReference Include="HelixScheduler.Infrastructure.SqlServer" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
